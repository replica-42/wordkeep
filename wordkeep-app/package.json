{
  "name": "wordkeep-app",
  "version": "0.1.0",
  "description": "拾言 Wordkeep — turn personal writing into word clouds",
  "author": {
    "name": "replica42",
    "email": "replica42@outlook.com"
  },
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=12.0.0"
  },
  "packageManager": "npm@12.2.2",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "check": "npm run typecheck && biome check .",
    "format": "biome check --write .",
    "build": "npm run check && electron-vite build",
    "postinstall": "node scripts/install-electron.cjs",
    "test": "vitest run",
    "test:desktop": "npm run build && vitest run --config vitest.desktop.config.ts",
    "clean": "node scripts/clean.cjs"
  },
  "dependencies": {
    "@remixicon/react": "4.9.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.2",
    "electron-vite": "6.0.0",
    "jsdom": "31.0.1",
    "playwright": "1.65.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "fsevents": false
  }
}
